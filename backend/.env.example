DATABASE_URL=postgres://localhost/margincite_dev
BIND_ADDR=127.0.0.1:8787
DEV_API_TOKENS=dev-token=you@example.com
# Everything below DATABASE_URL, BIND_ADDR and DEV_API_TOKENS can be set in the
# app (Settings) instead. A value saved in the app wins; these are the fallback.
#
# Optional fallback for the contact address sent with every crawl request. Set
# it in the app, or here; crawling is refused until one exists.
# CRAWLER_CONTACT=https://example.com/margincite-bot
# Optional. Renders pages that need JavaScript. Rendering only turns on when
# RENDER_SITES_I_TRUST=yes is also set.
# WARNING: rendering lets the pages being crawled make your machine fetch
# internal addresses. Turn it on only on your own machine, for sites you own.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# RENDER_SITES_I_TRUST=yes

# Integrations. Every one is optional; a feature whose setting is missing is
# simply off. None of these values is ever returned by the API.
# Encrypts everything secret in the database. Leave it unset and the first start
# makes .data/secret.key for you (back that file up). To use your own, 32 random
# bytes, base64: openssl rand -base64 32
# MARGINCITE_SECRET_KEY=
# Where the generated secret.key lives. Default: .data
# MARGINCITE_DATA_DIR=.data
# Where the web app lives. Google sends people back here after they approve.
# PUBLIC_BASE_URL=http://localhost:5174
# Google Search Console sign-in. Set both or neither, and MARGINCITE_SECRET_KEY
# above too. The OAuth client's redirect URI must be exactly
# PUBLIC_BASE_URL + /api/v1/oauth/google/callback. See the README for the steps.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Bing Webmaster Tools backlinks need only MARGINCITE_SECRET_KEY above. The API
# key (Bing Webmaster Tools, Settings, API access) is pasted into the app per
# site, never set here.
# AI engines asked about a brand. An engine without a key is off.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# XAI_API_KEY=
# GROK_MODEL=grok-4.7
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Keyword and search data (DataForSEO) and page speed (Google PageSpeed Insights).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# PAGESPEED_API_KEY=
